{
  "name": "understudy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=artifacts/unit-tests.json",
    "validate": "vitest run --config vitest.validate.config.ts",
    "build": "vite build && node tools/site-evidence.mjs && node tools/precache.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
