    "peerjs": "1.5.5",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/reference": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@meta-quest/metavr": "^1.3.2",
    "@types/three": "^0.181.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.63.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "sharp": "0.35.4",
