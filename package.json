{
  "name": "understudy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "vitest run --config vitest.validate.config.ts",
    "e2e": "node tools/e2e-suite.mjs",
    "s6": "node tools/s6.mjs",
    "report": "node tools/report.mjs",
    "voice": "python tools/voice.py",
    "build": "vite build && node tools/precache.mjs",
    "preview": "vite preview",
    "check:offline": "node tools/check-offline.mjs",
    "check:offline:session": "node tools/check-offline.mjs --session",
    "check:release": "node tools/release-smoke.mjs",
    "check:audit": "node tools/audit-smoke.mjs",
    "check:watch": "node tools/check-watch.mjs",
    "check:judges": "node tools/check-judges.mjs",
    "check:performance": "node tools/check-performance.mjs",
    "check:render": "node tools/check-render-equivalence.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/reference": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@meta-quest/metavr": "^1.3.2",
    "@types/three": "^0.181.0",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.63.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
